{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "installCommand": "npm ci",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/ko/index.html" },
    { "source": "/en(.*)", "destination": "/en$1" },
    { "source": "/ko(.*)", "destination": "/ko$1" }
  ]
}
