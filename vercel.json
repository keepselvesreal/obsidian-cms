{
  "buildCommand": "npm run build:all && npm run cleanup",
  "outputDirectory": "public",
  "installCommand": "npm ci",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/en/attachments/:path*",
      "destination": "/attachments/:path*"
    },
    {
      "source": "/en/(.*)",
      "destination": "/en/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
